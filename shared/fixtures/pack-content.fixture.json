    {
      "name": "numeric entities including a surrogate pair",
      "input": "caf&#233; &#128512;",
      "expected": "café 😀"
    },
    {
      "name": "unknown tags are unwrapped, text survives",
      "input": "<section><custom-tag>Keep this text</custom-tag></section>",
      "expected": "Keep this text"
    },
    {
      "name": "hr becomes a thematic break",
      "input": "<p>Above</p><hr><p>Below</p>",
      "expected": "Above\n\n---\n\nBelow"
    },
    {
      "name": "preformatted code block keeps its newlines",
      "input": "<pre>if (a) {\n  b();\n}</pre>",
      "expected": "```\nif (a) {\n  b();\n}\n```"
    },
    {
      "name": "links keep label and href",
      "input": "See <a href=\"https://example.com/x\">the guide</a>.",
      "expected": "See [the guide](https://example.com/x)."
    }
