# Backend runtime configuration.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Server ---
PORT=5000
DATABASE_URL=
NODE_ENV=development

# --- Certificates (required in production) ---
# Every certificate is HMAC-signed with CERT_SIGNING_SECRET. Keep this separate
# from JWT_SECRET: rotating the JWT secret must not invalidate certificates that
# students have already printed and are holding.
# Must be >= 16 characters. Production startup fails loudly if it is missing.
CERT_SIGNING_SECRET=

# The public origin, no trailing slash. This is baked into the QR code on every
# certificate PDF and into the verification link. Leave it unset in development
# and the links point at http://localhost:3000, which is fine locally and
# useless anywhere else — production refuses to issue while it is a localhost
# address, because a certificate nobody can verify is worse than no certificate.
NEXT_PUBLIC_SITE_URL=https://tieedu.com

# --- Payments ---
# 'upi' (QR + manual admin verification, always real) or 'razorpay' (automatic,
# requires all three keys below).
PAYMENT_MODE=upi
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
