# Backend runtime configuration.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Server ---
PORT=5000
DATABASE_URL=
NODE_ENV=development

# --- Certificates (required in production) ---
# Certificates are signed with an Ed25519 PRIVATE key. Only the private half
# stays on this server; the public half is published at
# GET /api/courses/verify/key so anyone can check a certificate without
# trusting us. That asymmetry is the point - a leaked public key cannot forge
# anything, which an HMAC secret never could.
#
# Generate a keypair with:
#   node -e "const c=require('crypto'),{privateKey,publicKey}=c.generateKeyPairSync('ed25519');\
#   console.log('CERT_SIGNING_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
#
# Only the private half is configured - the public key is derived from it and
# published at /api/courses/verify/key. Do not add a separate public key
# variable: one that disagrees with the private key would leave every issued
# certificate unverifiable while still looking like it worked.
#
# Losing the private half means every future certificate is unverifiable, so
# back it up somewhere your host cannot overwrite.
CERT_SIGNING_PRIVATE_KEY=

# Preferred instead of the above, where your platform can mount a secret as a
# file (Docker/Kubernetes secrets, systemd LoadCredential). Keeps the key out of
# the process environment, where anything able to read /proc can see it.
# CERT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/tieedu-cert-key

# Rotation: the verifier must keep accepting the previous public key, or every
# certificate already printed stops verifying. Format is
# `keyid:base64spkiDER,keyid:base64spkiDER`; the key id is the fingerprint
# printed on the certificate and on the PDF, so it is recomputed from the key
# rather than trusted from here. Remove an entry once no certificate it signed
# is still in circulation.
CERT_RETIRED_PUBLIC_KEYS=

# The public origin, no trailing slash. This is baked into the QR code on every
# certificate PDF and into the verification link. Leave it unset in development
# and the links point at http://localhost:3000, which is fine locally and
# useless anywhere else - production refuses to issue while it is a localhost
# address, because a certificate nobody can verify is worse than no certificate.
NEXT_PUBLIC_SITE_URL=https://tieedu.com

# --- Payments ---
# 'upi' (QR + manual admin verification, always real) or 'razorpay' (automatic,
# requires all three keys below).
PAYMENT_MODE=upi
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
