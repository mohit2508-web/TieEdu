{
  "name": "tieedu-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:courses && npm run test:pack && npm run test:repair && npm run test:api && npm run test:posters && npm run test:data && npm run test:smoke",
    "test:unit": "ts-node --transpile-only scripts/study-plan.test.ts",
    "test:courses": "ts-node --transpile-only scripts/courses-lib.test.ts",
    "test:pack": "ts-node --transpile-only scripts/pack-content.test.ts",
    "test:repair": "ts-node --transpile-only scripts/repair.test.ts",
    "repair:packs": "ts-node --transpile-only scripts/repair-pack-content.ts",
    "test:api": "ts-node --transpile-only scripts/study-plan-api.test.ts",
    "test:posters": "ts-node --transpile-only scripts/posters-api.test.ts",
    "test:data": "ts-node --transpile-only scripts/section-data.test.ts",
    "test:smoke": "ts-node --transpile-only src/scripts/smokeCourses.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.8",
    "@types/qrcode": "^1.5.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
