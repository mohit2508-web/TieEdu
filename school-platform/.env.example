# ---------------------------------------------------------------------------
# TieEdu School of Technology — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://tieedu:tieedu@localhost:5432/tieedu_school?schema=public"

# Redis (BullMQ queues + OTP rate limiting)
REDIS_URL="redis://localhost:6379"

# Public app URL (used for links, referral links, verification pages)
NEXT_PUBLIC_APP_URL="http://localhost:3300"

# Auth secrets. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Access token TTL in seconds (default 15 min)
ACCESS_TOKEN_TTL="900"
# Refresh/session TTL in days
REFRESH_TTL_DAYS="30"

# S3 / MinIO (docker-compose default)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="tieedu-school"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# --- Notification providers (adapter pattern; leave blank to log to console)
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
SMS_PROVIDER=""
SMS_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="schools@tieedu.com"

# --- Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Seed
SEED_RESET="false"
SEED_ADMIN_EMAIL="admin@tieedu.com"
SEED_ADMIN_PASSWORD="ChangeMe#2026"
